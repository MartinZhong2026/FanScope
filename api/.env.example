# Copy to api/.env on server; never commit the real file
PORT=8787
DATABASE_PATH=./data/fanscope.sqlite
# Production HTTPS origins separated by comma. Pages preview origins need explicit addition.
ALLOWED_ORIGINS=https://fanscope.pages.dev,http://localhost:4173,http://127.0.0.1:4173
PUBLIC_FRONTEND_URL=https://fanscope.pages.dev
PUBLIC_API_URL=https://fanscope-api.adapttochina.com
ADMIN_KEY=REPLACE_WITH_LONG_RANDOM_SECRET
CROSSREF_CONTACT_EMAIL=research@example.com
SCAN_INTERVAL_MINUTES=120
SCAN_ON_START=true
INITIAL_LOOKBACK_DAYS=30
MAX_CROSSREF_PAGES=4
MAX_AI_PER_SCAN=2
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Resend requires a verified sending domain; not configured => no mail sent
RESEND_API_KEY=
EMAIL_FROM=FanScope <research@your-verified-domain.com>
# Daily/weekly email delivery at 08:00 China Standard Time
TIME_ZONE=Asia/Shanghai
# Public subscribe requires email integration
ENABLE_PUBLIC_SUBSCRIPTIONS=true

# Independent abstract queue runs every 15 minutes, one request at a time.
MAX_DOCUMENT_AI_DAILY=10
# Optional OpenAlex supplement, only after operator checks current plan/terms.
OPENALEX_ENABLED=false
OPENALEX_API_KEY=
OPENALEX_MAX_DAILY=10

# Ambient paid AI remains disabled. Admin-only analysis batches require
# explicit creation and start actions; no daily or CNY spending limit is enforced.
AUTO_AI_ANALYSIS=false
# Optional CNY price rates are only for reporting estimated usage.
# The absence of price rates does not prevent administrator-started work.
AI_INPUT_CNY_PER_M_TOKENS=
AI_OUTPUT_CNY_PER_M_TOKENS=
# MAX_AI_DAILY and former per-batch CNY limits are intentionally retired.
# Paid AI runs only after an administrator starts a batch; provider balance applies.
